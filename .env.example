# ---------------------------------------------------------------------------
# Khelo Sanand BalOlympiad — environment
# Copy to .env for local development. Never commit a real .env.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://khel:khel_dev_only@localhost:5432/khel_sanand?schema=public"

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# Event timezone. IST has no daylight saving, so this is stable year-round (§1).
EVENT_TIMEZONE=Asia/Kolkata

# Session signing secret. Generate with: openssl rand -base64 48
# §14: secret management; never logged, never returned by any endpoint.
SESSION_SECRET="change-me-in-every-environment"
SESSION_TTL_MINUTES=720

# Private object storage for documents and exports (§14).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=khel-documents
STORAGE_ACCESS_KEY=khel
STORAGE_SECRET_KEY=khel_dev_only
# Signed download URLs are short-lived and issued only after authorisation.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Outbound channels are OPTIONAL and disabled until the organiser approves
# channel, templates, recipients and costs for the event (§11).
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SMS_ENABLED=false
NOTIFY_WHATSAPP_ENABLED=false

# Default UI language. Gujarati for a Sanand deployment (docs/INDIA_DATA_MODEL.md).
DEFAULT_LOCALE=gu
