// ---------------------------------------------------------------- models

/// M01 — One event edition
/// Scope: Global
model Event {
  id                                 String   @id @default(uuid()) @db.Uuid  /// Immutable primary key
  created_at                         DateTime @default(now()) @db.Timestamptz(3)  /// Server creation time
  created_by                         String @db.Uuid  /// Creating actor or named service identity
  updated_at                         DateTime @updatedAt @db.Timestamptz(3)  /// Last server change time
  updated_by                         String @db.Uuid  /// Last actor
  row_version                        Int      @default(1)  /// Monotonic optimistic concurrency version
  event_code                         String  /// Unique immutable event code
  name                               String  /// Display name
  timezone                           String  /// IANA timezone
  start_date                         DateTime @db.Date  /// Event first day
  end_date                           DateTime @db.Date  /// Event last day
  status                             EventStatus
  registration_opens_at              DateTime? @db.Timestamptz(3)  /// Entry window start
  registration_closes_at             DateTime? @db.Timestamptz(3)  /// Entry window end
  configuration_version              Int  /// Active approved settings version

  // --- India-specific additions (docs/INDIA_DATA_MODEL.md) ---
  /// GAP-IN-09. Indian school editions are labelled '2026-27' because the academic year spans June–April. The spec's edition label is free text; validated against ACADEMIC_YEAR_RE.
  academic_year                      String?
  /// GAP-IN-11. §1 lists Gujarati/Hindi/English as OPTIONAL. For a Sanand event Gujarati is the working language, so it is the default rather than an opt-in.
  default_locale                     Locale   @default(gu)
  aggregate_snapshots                          AggregateSnapshot[]
  amendments                                   Amendment[]
  athlete_registrations                        AthleteRegistration[]
  attendance_corrections                       AttendanceCorrection[]
  attendances                                  Attendance[]
  audit_events                                 AuditEvent[]
  categories                                   Category[]
  clusters                                     Cluster[]
  competition_entries                          CompetitionEntry[]
  competition_stages                           CompetitionStage[]
  competitions                                 Competition[]
  configuration_versions                       ConfigurationVersion[]
  consent_records                              ConsentRecord[]
  delivery_attempts                            DeliveryAttempt[]
  documents                                    Document[]
  duty_availabilities                          DutyAvailability[]
  duty_sessions                                DutySession[]
  eligibility_decisions                        EligibilityDecision[]
  event_memberships                            EventMembership[]
  event_schools                                EventSchool[]
  exception_cases                              ExceptionCase[]
  expected_duties                              ExpectedDuty[]
  fixture_assignments                          FixtureAssignment[]
  fixture_dependencies                         FixtureDependency[]
  fixture_participants                         FixtureParticipant[]
  fixtures                                     Fixture[]
  guardians                                    Guardian[]
  idempotency_keys                             IdempotencyKey[]
  import_jobs                                  ImportJob[]
  import_rows                                  ImportRow[]
  job_runs                                     JobRun[]
  kit_entitlements                             KitEntitlement[]
  kit_issues                                   KitIssue[]
  kit_items                                    KitItem[]
  notification_events                          NotificationEvent[]
  notification_recipients                      NotificationRecipient[]
  outbox_messages                              OutboxMessage[]
  recovery_runs                                RecoveryRun[]
  report_jobs                                  ReportJob[]
  resource_availabilities                      ResourceAvailability[]
  result_publications                          ResultPublication[]
  result_snapshots                             ResultSnapshot[]
  review_actions                               ReviewAction[]
  rule_versions                                RuleVersion[]
  school_c_h_assignments                       SchoolCHAssignment[]
  school_sport_participations                  SchoolSportParticipation[]
  scope_grants                                 ScopeGrant[]
  score_observations                           ScoreObservation[]
  score_templates                              ScoreTemplate[]
  scorecard_revisions                          ScorecardRevision[]
  scorecards                                   Scorecard[]
  start_lists                                  StartList[]
  stock_locations                              StockLocation[]
  stock_movements                              StockMovement[]
  subscription_preferences                     SubscriptionPreference[]
  team_members                                 TeamMember[]
  teams                                        Team[]
  venue_resources                              VenueResource[]
  venues                                       Venue[]
  volunteer_pool_assignments                   VolunteerPoolAssignment[]
  volunteer_profiles                           VolunteerProfile[]
  volunteer_school_assignments                 VolunteerSchoolAssignment[]

  @@unique([event_code])
  @@map("events")
}

/// M01 — Reusable school identity
/// Scope: Global
model School {
  id                                 String   @id @default(uuid()) @db.Uuid  /// Immutable primary key
  created_at                         DateTime @default(now()) @db.Timestamptz(3)  /// Server creation time
  created_by                         String @db.Uuid  /// Creating actor or named service identity
  updated_at                         DateTime @updatedAt @db.Timestamptz(3)  /// Last server change time
  updated_by                         String @db.Uuid  /// Last actor
  row_version                        Int      @default(1)  /// Monotonic optimistic concurrency version
  school_code                        String  /// Canonical unique code
  name                               String  /// School name
  address                            String  /// Operational address [Restricted]
  district                           String  /// District
  city                               String  /// City
  contact_name                       String  /// Responsible school contact
  phone                              String?  /// Canonical contact number [Restricted]
  email                              String?  /// Validated contact email [Restricted]
  active                             Boolean  /// Global master status

  // --- India-specific additions (docs/INDIA_DATA_MODEL.md) ---
  /// GAP-IN-05. §1 requires names retain their original script. Holds the Gujarati/Devanagari school name.
  name_local                         String?
  /// GAP-IN-02. The 11-digit UDISE+ code issued by the Ministry of Education. Makes the school master reconcilable with government data and survives renames. Optional: some private unaided schools cannot supply it at registration, and blocking on it is worse than missing it.
  udise_code                         String?
  /// GAP-IN-01. ISO 3166-2:IN subdivision code. Needed once an event spans more than one district.
  state_code                         String?
  /// GAP-IN-01. India's operational hierarchy is State → District → Taluka → City/Village. Sanand is a taluka of Ahmedabad district; without this level the catchment cannot be expressed.
  taluka                             String?
  /// GAP-IN-01. The only machine-checkable locality key in an Indian address.
  pincode                            String?
  /// GAP-IN-02. Affiliation (GSEB/CBSE/…) determines how standards map to age bands.
  board                              SchoolBoard?
  /// GAP-IN-02. Government and municipal schools route approvals through the education department; private unaided do not. Operationally significant for CH assignment.
  management_type                    SchoolManagement?
  /// GAP-IN-02. Drives the default UI language for that school's staff and the language of printed start lists.
  medium_of_instruction              MediumOfInstruction?
  event_schools                                EventSchool[]

  @@unique([school_code])
  @@unique([udise_code])
  @@index([district, taluka])
  @@map("schools")
}

/// M01 — School participation in an edition
/// Scope: Event scoped
model EventSchool {
  id                                 String   @id @default(uuid()) @db.Uuid  /// Immutable primary key
  event_id                           String @db.Uuid  /// Event boundary; same-event foreign keys required
  event                              Event @relation(fields: [event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  created_at                         DateTime @default(now()) @db.Timestamptz(3)  /// Server creation time
  created_by                         String @db.Uuid  /// Creating actor or named service identity
  updated_at                         DateTime @updatedAt @db.Timestamptz(3)  /// Last server change time
  updated_by                         String @db.Uuid  /// Last actor
  row_version                        Int      @default(1)  /// Monotonic optimistic concurrency version
  school_id                          String @db.Uuid  /// Reusable school
  school                             School @relation(fields: [school_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  participation_status               ParticipationStatus
  notes                              String?  /// Scoped operational notes
  athlete_registrations                        AthleteRegistration[]
  school_c_h_assignments                       SchoolCHAssignment[]
  school_sport_participations                  SchoolSportParticipation[]
  teams                                        Team[]
  volunteer_school_assignments                 VolunteerSchoolAssignment[]

  @@unique([event_id, school_id])
  @@index([event_id, participation_status])
  @@map("event_schools")
}

/// M01 — Management cluster
/// Scope: Event scoped
model Cluster {
  id                                 String   @id @default(uuid()) @db.Uuid  /// Immutable primary key
  event_id                           String @db.Uuid  /// Event boundary; same-event foreign keys required
  event                              Event @relation(fields: [event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  created_at                         DateTime @default(now()) @db.Timestamptz(3)  /// Server creation time
  created_by                         String @db.Uuid  /// Creating actor or named service identity
  updated_at                         DateTime @updatedAt @db.Timestamptz(3)  /// Last server change time
  updated_by                         String @db.Uuid  /// Last actor
  row_version                        Int      @default(1)  /// Monotonic optimistic concurrency version
  cluster_code                       String  /// Event-unique code
  name                               String  /// Display label
  active                             Boolean  /// Availability for assignment
  expected_duties                              ExpectedDuty[]
  school_c_h_assignments                       SchoolCHAssignment[]
  stock_locations                              StockLocation[]
  volunteer_pool_assignments                   VolunteerPoolAssignment[]

  @@unique([event_id, cluster_code])
  @@map("clusters")
}

/// M01 — Physical operational location
/// Scope: Event scoped
model Venue {
  id                                 String   @id @default(uuid()) @db.Uuid  /// Immutable primary key
  event_id                           String @db.Uuid  /// Event boundary; same-event foreign keys required
  event                              Event @relation(fields: [event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  created_at                         DateTime @default(now()) @db.Timestamptz(3)  /// Server creation time
  created_by                         String @db.Uuid  /// Creating actor or named service identity
  updated_at                         DateTime @updatedAt @db.Timestamptz(3)  /// Last server change time
  updated_by                         String @db.Uuid  /// Last actor
  row_version                        Int      @default(1)  /// Monotonic optimistic concurrency version
  venue_code                         String  /// Event-unique code
  name                               String  /// Venue name
  address                            String  /// Operational address [Restricted]
  contact_name                       String?  /// Venue contact
  contact_phone                      String?  /// Operational phone [Restricted]
  active                             Boolean  /// Available venue
  duty_sessions                                DutySession[]
  venue_resources                              VenueResource[]

  @@unique([event_id, name])
  @@map("venues")
}

/// M01 — Bookable pitch/court/track/board area
/// Scope: Event scoped
model VenueResource {
  id                                 String   @id @default(uuid()) @db.Uuid  /// Immutable primary key
  event_id                           String @db.Uuid  /// Event boundary; same-event foreign keys required
  event                              Event @relation(fields: [event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  created_at                         DateTime @default(now()) @db.Timestamptz(3)  /// Server creation time
  created_by                         String @db.Uuid  /// Creating actor or named service identity
  updated_at                         DateTime @updatedAt @db.Timestamptz(3)  /// Last server change time
  updated_by                         String @db.Uuid  /// Last actor
  row_version                        Int      @default(1)  /// Monotonic optimistic concurrency version
  venue_id                           String @db.Uuid  /// Parent location
  venue                              Venue @relation(fields: [venue_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resource_code                      String  /// Unique code in venue
  resource_type                      ResourceType
  capacity                           Int  /// Concurrent slots
  compatible_disciplines             Json  /// Allowed discipline codes
  active                             Boolean  /// Available resource
  fixtures                                     Fixture[]
  resource_availabilities                      ResourceAvailability[]

  @@unique([venue_id, resource_code])
  @@index([event_id, resource_type])
  @@map("venue_resources")
}

/// M01 — Resource booking windows
/// Scope: Event scoped
model ResourceAvailability {
  id                                 String   @id @default(uuid()) @db.Uuid  /// Immutable primary key
  event_id                           String @db.Uuid  /// Event boundary; same-event foreign keys required
  event                              Event @relation(fields: [event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  created_at                         DateTime @default(now()) @db.Timestamptz(3)  /// Server creation time
  created_by                         String @db.Uuid  /// Creating actor or named service identity
  updated_at                         DateTime @updatedAt @db.Timestamptz(3)  /// Last server change time
  updated_by                         String @db.Uuid  /// Last actor
  row_version                        Int      @default(1)  /// Monotonic optimistic concurrency version
  resource_id                        String @db.Uuid  /// Bookable resource
  resource                           VenueResource @relation(fields: [resource_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  starts_at                          DateTime @db.Timestamptz(3)  /// Window start
  ends_at                            DateTime @db.Timestamptz(3)  /// Window end
  kind                               AvailabilityKind
  reason                             String?  /// Closure or availability note

  @@index([resource_id, starts_at, ends_at])
  @@map("resource_availabilities")
}

