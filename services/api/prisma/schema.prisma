/// M04 — Private uploaded evidence
/// Scope: Event scoped
model Document {
  id                                 String   @id @default(uuid()) @db.Uuid  /// Immutable primary key
  event_id                           String @db.Uuid  /// Event boundary; same-event foreign keys required
  event                              Event @relation(fields: [event_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  created_at                         DateTime @default(now()) @db.Timestamptz(3)  /// Server creation time
  created_by                         String @db.Uuid  /// Creating actor or named service identity
  updated_at                         DateTime @updatedAt @db.Timestamptz(3)  /// Last server change time
  updated_by                         String @db.Uuid  /// Last actor
  row_version                        Int      @default(1)  /// Monotonic optimistic concurrency version
  owner_type                         DocumentOwnerType
  owner_id                           String @db.Uuid  /// Typed owner
  document_type                      String   /// Legacy free-text label; document_type_code is authoritative
  object_key                         String  /// Private storage reference [Restricted]
  mime_type                          String  /// Validated content type
  size_bytes                         Int  /// File size
  checksum                           String  /// Integrity checksum
  verification_status                VerificationStatus
  verified_by                        String? @db.Uuid  /// Reviewer
  verified_by_ref                    User? @relation(fields: [verified_by], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verified_at                        DateTime? @db.Timestamptz(3)  /// Review time

  // --- India-specific additions (docs/INDIA_DATA_MODEL.md) ---
  /// GAP-IN-06. The spec's document_type is free text. A closed vocabulary lets the service refuse retention of the types that must not be kept.
  document_type_code                 DocumentType?
  /// GAP-IN-06/07. §13 requires retention policy to distinguish operational results from personal documents. An explicit expiry makes the purge job possible and auditable.
  retention_expires_at               DateTime? @db.Timestamptz(3)
  /// GAP-IN-06. Where an auditor must reconcile one record, only the last four digits are held. The full identity number is never stored — see docs/INDIA_DATA_MODEL.md.
  sighted_last_four                  String?
  consent_evidence                             ConsentRecord[]
  import_jobs_error_document_id                ImportJob[] @relation("ImportJob_error_document_id")
  import_jobs_source_document_id               ImportJob[] @relation("ImportJob_source_document_id")
  report_jobs                                  ReportJob[]

  @@index([event_id, owner_type, owner_id])
  @@index([retention_expires_at])
  @@map("documents")
}

